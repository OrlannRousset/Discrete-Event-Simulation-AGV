// Les lois telles que vues en cours 
// LOI UNIFORME(0,1) 
 
float U_0_1(){ 
    int a = 7 , b = 749, c = 1196; 
    float z, R; 
    z = (a*z0+b)%c; 
    z0 = (int)z; 
    R = z/c; 
    return R; 
} 
 
float U_0_11(){ 
    int a = 7 , b = 749, c = 1196; 
    float z, R; 
    z = (a*z1+b)%c; 
    z1 = (int)z; 
    R = z/c; 
    return R; 
} 
 
// 1. LOI EXPONENTIELLE (Temps entre deux arrivées de lots) 
float Expo(float lambda){ 
    return (-1/lambda)*log(U_0_11()); 
} 
 
 // 3. LOI DISCRÈTE (Répartition des zone de dépôt) 
int D(int X[],double P[]){ 
    float s ,R;  
    int i=0; 
    s=P[i]; 
    R = U_0_11(); 
    while(s < R){ 
        i = i+1; 
        s=s + P[i]; 
    } 
    return X[i]; 
} 
 
// 2. LOI NORMALE / GAUSSIENNE (Temps de chargement et déchargement) 
// Utilise la méthode de Box-Muller pour transformer deux nombres uniformes en une distribution de Gauss 
double N(double m, double o) { 
    double r1 = U_0_1(); 
    double r2 = U_0_1(); 
     
    // Sécurité log(0) 
    if (r1 == 0.0) r1 = 0.0000001; 
     
    // M_PI est la constante de Pi (3.14159...) définie dans <math.h> 
    double z = sqrt(-2.0 * log(r1)) * cos(2.0 * M_PI * r2); 
     
    // Ajustement avec la moyenne (m) et l'écart-type (o) 
    return m + (z * o); 
} 
 
