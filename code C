// Les évènements 
void Arrivee_lot(int i) { 
     
    //float e=Expo(lambda); 
    Ajouter(t + Expo(lambda), 1, 0, D(X , P));  
    //printf("e = %f\n", e); 
     
    if (Z[0] == 0) {  
        if (M[1] == 0) {  
            Z[0]=1; 
            M[1] = 100; 
            Ajouter(t + N(m[0], o[0]), 2, 1, i);  
             
        } 
        else if (M[2] == 0) {  
            Z[0]=1; 
            M[2] = 100;  
            Ajouter(t +N(m[0], o[0]), 2, 2, i);  
             
        } 
        else { 
            File[F] = i; 
            F = F + 1; 
        } 
    } 
    else { 
        File[F] = i; 
        F = F + 1; 
    } 
    if(kpi_stock_max<F){ 
        kpi_stock_max = F; 
    } 
} 
 
void fin_Chargement_lot(int i, int j) { 
    Ajouter(t + N(m[i], o[i]), 3, j, i);  
    Z[0] = 0; 
     
     
    if (F > 0) { 
        if (M[1] == 0) {  
            Ajouter(t + N(m[0], o[0]), 2, 1, File[0]);  
            Z[0] = 1; 
            Supprimer_File(); 
            M[1] = 100;      
        } 
        else if (M[2] == 0) {  
            Ajouter(t + N(m[0], o[0]), 2, 2, File[0]);  
            Z[0] = 1; 
            Supprimer_File(); 
            M[2] = 100;      
        } 
    } 
} 
 
void Arrivee_en_i(int i, int j) { 
    if (Z[i] == 0) {  
        Z[i] = 1; 
        Ajouter(t + N(m[9], o[9]), 4, j, i);  
    } 
    else { 
        M[j] = i; 
        kpi_attentes_zone = kpi_attentes_zone + 1; 
    } 
} 
 
void Fin_dechargement(int i, int j) { 
    Ajouter(t + N(m[2*i], o[2*i]), 5, j, i);  
    Z[i] = 0; 
    kpi_lots_traites = kpi_lots_traites + 1; 
     
    if (M[1] == i) {  
        Ajouter(t + N(m[9], o[9]), 4, 1, i); 
        Z[i] = 1; 
        M[1] = 100; 
    } 
    else if (M[2] == i) {  
        Ajouter(t + N(m[9], o[9]), 4, 2, i); 
        Z[i] = 1; 
        M[2] = 100; 
    } 
} 
 
void Retour_camion(int j) { 
    if (F > 0) { 
        if (Z[0] == 0) {  
            Ajouter(t + N(m[0], o[0]), 2, j, File[0]); 
            Supprimer_File(); 
            Z[0] = 1;  
        } 
        else { 
            M[j] = 0; 
            kpi_attentes_charg = kpi_attentes_charg + 1; 
        } 
    } 
    else { 
        M[j] = 0; 
    } 
} 
 
