//Déclarations des fonctions externes simulées 
void Supprimer_File(void) { 
    int k; 
    for (k = 0; k < F - 1; k++) {  
        File[k] = File[k + 1];     
    } 
    if (F > 0) { 
        File[F - 1] = 0; 
        F = F - 1; 
    } 
}  
 
void Ajouter(float temps, int zone, int camion, int zone_depot) { 
    int k = 0;  
    int x; 
     
    // On cherche la position en veillant à ne pas dépasser l'indice 4 
    while (k < N_ev - 1 && Tab[0][k] <= temps) {  
        k = k + 1; 
    } 
     
    // Correction : Le décalage commence à l'indice max autorisé (4) au lieu de 5 
    for (x = N_ev-1; x > k; x--) {  
        Tab[0][x] = Tab[0][x - 1]; 
        Tab[1][x] = Tab[1][x - 1]; 
        Tab[2][x] = Tab[2][x - 1]; 
        Tab[3][x] = Tab[3][x - 1]; 
    } 
     
    // Insertion à la bonne position (qui est forcément entre 0 et 4) 
    Tab[0][k] = temps;  
    Tab[1][k] = zone; 
    Tab[2][k] = camion; 
    Tab[3][k] = zone_depot;  
} 
 
void Suprimer(void) { 
    int x; 
    // On décale les éléments vers la gauche jusqu'à l'avant-dernière case (3) 
    for (x = 0; x < N_ev-1; x++) {  
        Tab[0][x] = Tab[0][x + 1]; 
        Tab[1][x] = Tab[1][x + 1]; 
        Tab[2][x] = Tab[2][x + 1]; 
        Tab[3][x] = Tab[3][x + 1]; 
    } 
    // Correction : On "neutralise" la dernière case disponible (indice 4 au lieu de 5) 
    Tab[0][N_ev-1] = 2 * H; 
} 
 
